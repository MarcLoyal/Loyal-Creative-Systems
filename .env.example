# Loyal Creative Systems — environment variables (SPEC 21.3)
# Copy to .env.local for development. Never commit real values.
# Phase in brackets = when the variable is first needed.

# ---- Site ------------------------------------------------------------------
# Public base URL, used for canonical URLs, sitemap and email links. [1]
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Public contact address shown on /contact and in the footer ([DECISION] D3). [1]
NEXT_PUBLIC_CONTACT_EMAIL=
# Where team notifications (T2, A1, A2) are sent. [3]
TEAM_NOTIFICATION_EMAIL=
# Development only: pretend the request came from this country (PH or US) to test market detection. [1]
DEV_COUNTRY=

# ---- Supabase (database, auth, storage, realtime) ---------------------------
# Project URL from Supabase → Project Settings → API. [1]
NEXT_PUBLIC_SUPABASE_URL=
# Anonymous (public) key. Safe for the browser; row-level security protects data. [1]
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key. SERVER ONLY: bypasses row-level security. [1]
SUPABASE_SERVICE_ROLE_KEY=

# ---- Tests -----------------------------------------------------------------
# Superuser connection for the database tests; each test file creates and drops its own database.
# Locally: export TEST_DATABASE_URL=$(scripts/local-postgres.sh start)
TEST_DATABASE_URL=

# ---- AI (Claude API) ---------------------------------------------------------
# Anthropic API key. Server only. [3]
ANTHROPIC_API_KEY=

# ---- Background workflows (Inngest) ------------------------------------------
# Event key for sending events. [3]
INNGEST_EVENT_KEY=
# Signing key that verifies Inngest calls to /api/inngest. [3]
INNGEST_SIGNING_KEY=

# ---- Email (Resend) ----------------------------------------------------------
# API key for sending. [3]
RESEND_API_KEY=
# Signing secret for Resend webhooks (delivery, open, click, bounce). [3]
RESEND_WEBHOOK_SECRET=
# Verified sending address, e.g. "Loyal Creative Systems <hello@yourdomain>" ([DECISION] D3). [3]
EMAIL_FROM=

# ---- Spam protection (Cloudflare Turnstile) ----------------------------------
# Site key (public). [3]
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Secret key for server-side verification. [3]
TURNSTILE_SECRET_KEY=

# ---- Rate limiting (Upstash Redis) -------------------------------------------
# REST URL and token. [3]
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- Booking (Cal.com) --------------------------------------------------------
# API key. [4]
CALCOM_API_KEY=
# Webhook signing secret. [4]
CALCOM_WEBHOOK_SECRET=
# Event type id for the 30-minute call. [4]
CALCOM_EVENT_TYPE_ID=

# ---- Payments ([DECISION] D1: providers not chosen yet) ------------------------
# One key + webhook secret per provider, e.g. PAYMENTS_PH_SECRET_KEY / PAYMENTS_PH_WEBHOOK_SECRET. [5]
PAYMENTS_PH_SECRET_KEY=
PAYMENTS_PH_WEBHOOK_SECRET=
PAYMENTS_US_SECRET_KEY=
PAYMENTS_US_WEBHOOK_SECRET=

# ---- Monitoring (Sentry) -------------------------------------------------------
# DSN for error reporting (public is fine). [1 optional, required by 10]
NEXT_PUBLIC_SENTRY_DSN=
# Auth token for uploading source maps at build time. [10]
SENTRY_AUTH_TOKEN=

# ---- Analytics -------------------------------------------------------------------
# Plausible domain (or PostHog key), loaded only after consent. [9]
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
